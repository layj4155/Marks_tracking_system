# Required - Application will fail to start without these
JWT_SECRET=your-secure-random-secret-min-32-chars

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/marks_tracking_system

# Server port
PORT=3000

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Registration codes for privileged roles (change these!)
TEACHER_REG_CODE=your-teacher-code
ADMIN_REG_CODE=your-admin-code

# Node environment
NODE_ENV=development

# Application URL (used in email links)
APP_URL=http://localhost:3000

# Email configuration (required for password reset emails)
# For Gmail: use App Password (https://myaccount.google.com/apppasswords)
# For SendGrid: use apikey as user, API key as pass, smtp.sendgrid.net as host
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Marks Tracking <noreply@yourdomain.com>
